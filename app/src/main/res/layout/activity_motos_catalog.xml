<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motos_catalog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Bottom Left Large Helmet Watermark -->
    <ImageView
        android:id="@+id/iv_catalog_watermark"
        style="@style/MarcaAguaCasco"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="-40dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/ll_catalog_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_back_home"
                style="@style/BotonIconoNav"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/biker_black"
                android:contentDescription="Regresar" />

            <TextView
                style="@style/TextoTituloVintage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Motos Disponibles" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.6"
                android:src="@drawable/ic_helmet_logo"
                android:contentDescription="Logo" />
        </LinearLayout>

        <!-- Scrollable 2-Column Grid for Motorcycles -->
        <ScrollView
            android:id="@+id/scroll_catalog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/card_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_catalog_header">

            <LinearLayout
                android:id="@+id/ll_motos_grid_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="30dp">
                <!-- Dynamically populated rows with 2 bikes per row -->
            </LinearLayout>
        </ScrollView>

        <!-- Floating Shopping Cart Button -->
        <FrameLayout
            android:id="@+id/btn_floating_cart"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@+id/card_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_floating_cart"
                android:elevation="6dp" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:src="@drawable/ic_shopping_cart"
                app:tint="@color/white"
                android:contentDescription="Carrito" />

            <TextView
                android:id="@+id/tv_cart_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_circle"
                android:elevation="10dp"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Bottom Navigation Bar -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_bottom_nav"
            style="@style/BarraNavegacionInferior"
            android:layout_width="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Profile Button -->
                <FrameLayout
                    android:id="@+id/nav_btn_profile"
                    style="@style/ItemNavegacion">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="@color/biker_gray_muted"
                        android:contentDescription="Perfil" />
                </FrameLayout>

                <!-- Home Button (Active) -->
                <FrameLayout
                    android:id="@+id/nav_btn_home"
                    style="@style/ItemNavegacion">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        app:tint="@color/biker_black"
                        android:contentDescription="Inicio" />
                </FrameLayout>

                <!-- Locations / Menu Button -->
                <FrameLayout
                    android:id="@+id/nav_btn_locations"
                    style="@style/ItemNavegacion">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/biker_gray_muted"
                        android:contentDescription="Menu" />
                </FrameLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
