<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motos_catalog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Bottom Left Large Helmet Watermark -->
    <ImageView
        android:id="@+id/iv_catalog_watermark"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="-40dp"
        android:alpha="0.20"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_helmet_logo"
        android:contentDescription="Watermark Casco" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Bar matching Figma -->
        <LinearLayout
            android:id="@+id/ll_catalog_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:letterSpacing="0.06"
                android:text="Disponibles"
                android:textColor="#111111"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.6"
                android:src="@drawable/ic_helmet_logo"
                android:contentDescription="Logo" />
        </LinearLayout>

        <!-- Scrollable 2-Column Grid for 10 Motorcycle Models -->
        <ScrollView
            android:id="@+id/scroll_catalog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/card_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_catalog_header">

            <!-- 2-Column Container -->
            <LinearLayout
                android:id="@+id/ll_motos_grid_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">
                <!-- Dynamically populated rows with 2 bikes per row -->
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar matching Figma -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#FFFFFF"
            app:cardElevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Profile Button -->
                <FrameLayout
                    android:id="@+id/nav_btn_profile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="#888888"
                        android:contentDescription="Perfil" />
                </FrameLayout>

                <!-- Home Button (Active) -->
                <FrameLayout
                    android:id="@+id/nav_btn_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        app:tint="#111111"
                        android:contentDescription="Inicio" />
                </FrameLayout>

                <!-- Locations / Menu Button -->
                <FrameLayout
                    android:id="@+id/nav_btn_locations"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_menu"
                        app:tint="#888888"
                        android:contentDescription="Sucursales" />
                </FrameLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
