<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Background Watermark Graphic -->
    <ImageView
        android:id="@+id/iv_map_watermark"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.18"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_tire_draw"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="Watermark" />

    <!-- City Selector Tabs -->
    <LinearLayout
        android:id="@+id/ll_city_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_city_cbba"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_pill_btn"
            android:backgroundTint="#212121"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Cochabamba"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_city_lapaz"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_pill_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="La Paz"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_city_elalto"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_pill_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="El Alto"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Map Container Card with Rounded Corners -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/btn_checkout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_city_selector">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Google MapView -->
            <com.google.android.gms.maps.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Location Overlay Card (Plus code, Directions, Share) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iv_store_thumb"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#EEEEEE"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_casco"
                        android:contentDescription="Tienda" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_store_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JR3R+HCQ"
                            android:textColor="#111111"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_store_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jordán, Cochabamba"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Directions Button -->
                    <ImageView
                        android:id="@+id/btn_map_directions"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_directions"
                        android:contentDescription="Cómo llegar" />

                    <!-- Share Button -->
                    <ImageView
                        android:id="@+id/btn_map_share"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_share"
                        android:contentDescription="Compartir" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Realizar Compra Button matching Figma -->
    <LinearLayout
        android:id="@+id/btn_checkout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.06"
            android:text="REALIZAR COMPRA"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="#111111"
            android:contentDescription="Continuar compra" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
