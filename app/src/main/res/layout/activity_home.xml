<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FB">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Top Header Banner with Curved Bottom -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_home_banner"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="34dp"
                app:cardElevation="6dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1B202C">

                    <!-- Subtle Tire Tracks Background -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.10"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_tire_tracks"
                        android:contentDescription="Textura Huellas" />

                    <!-- Top Right HOME & Logo -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:letterSpacing="0.08"
                                android:text="CHELO'S"
                                android:textColor="#FFB74D"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:text="Est. 2026"
                                android:textColor="#E0E0E0"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_helmet_logo"
                            app:tint="#FFFFFF"
                            android:contentDescription="Logo" />
                    </LinearLayout>

                    <!-- Welcome Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="110dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="Pasión Biker Oficial"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Catálogo con garantía y taller"
                            android:textColor="#B0BEC5"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Clean Frosted Search Bar -->
                    <LinearLayout
                        android:id="@+id/ll_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_glass_search"
                        android:elevation="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_search"
                            app:tint="#424242"
                            android:contentDescription="Buscar" />

                        <EditText
                            android:id="@+id/et_search"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:hint="Buscar motos, cascos, repuestos..."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:textColor="#111111"
                            android:textColorHint="#616161"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category Cards Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- 1. MOTOCICLETAS Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_motos"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="5dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_motos"
                        android:padding="16dp">

                        <!-- Left Text Content -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginEnd="130dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_btn"
                                android:backgroundTint="#33FFB74D"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="🏁 10 MODELOS EN STOCK"
                                android:textColor="#FFB74D"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="serif"
                                android:letterSpacing="0.06"
                                android:text="MOTOCICLETAS"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Sport • Enduro • Naked • City"
                                android:textColor="#CFD8DC"
                                android:textSize="10.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Explorar catálogo ➔"
                                android:textColor="#FFB74D"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Right Studio Cutout Image -->
                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="100dp"
                            android:layout_gravity="end|center_vertical"
                            android:scaleType="fitCenter"
                            android:src="@drawable/moto_ktm_power"
                            android:contentDescription="Motocicletas" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. CASCOS Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_cascos"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="5dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_cascos"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginEnd="130dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_btn"
                                android:backgroundTint="#33EF5350"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="🪖 8 CERTIFICADOS FIM"
                                android:textColor="#EF5350"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="serif"
                                android:letterSpacing="0.06"
                                android:text="CASCOS RACING"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="100% Carbono • ECE 22.06"
                                android:textColor="#CFD8DC"
                                android:textSize="10.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Explorar catálogo ➔"
                                android:textColor="#EF5350"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="110dp"
                            android:layout_height="100dp"
                            android:layout_gravity="end|center_vertical"
                            android:scaleType="fitCenter"
                            android:src="@drawable/casco_agv_pista"
                            android:contentDescription="Cascos" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. INDUMENTARIA Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_indumentaria"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="5dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_indumentaria"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginEnd="130dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_btn"
                                android:backgroundTint="#3326C6DA"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="🧥 EQUIPAMIENTO PRO"
                                android:textColor="#26C6DA"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="serif"
                                android:letterSpacing="0.06"
                                android:text="INDUMENTARIA"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Chaquetas • Monos • Botas"
                                android:textColor="#CFD8DC"
                                android:textSize="10.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Explorar catálogo ➔"
                                android:textColor="#26C6DA"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="110dp"
                            android:layout_height="100dp"
                            android:layout_gravity="end|center_vertical"
                            android:scaleType="fitCenter"
                            android:src="@drawable/gear_chaqueta_cuero"
                            android:contentDescription="Indumentaria" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
