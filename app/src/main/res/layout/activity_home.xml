<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Bottom Helmet Watermark -->
    <ImageView
        android:id="@+id/iv_home_watermark"
        style="@style/MarcaAguaCasco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Top Header Banner with Curved Bottom -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_home_banner"
                style="@style/TarjetaBannerHome"
                android:layout_width="match_parent"
                android:layout_height="210dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Banner Background Image -->
                    <ImageView
                        android:id="@+id/iv_home_banner_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_store_banner"
                        android:contentDescription="Banner Chelo Biker Shop" />

                    <!-- Dark Semi-transparent Overlay -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#55000000" />

                    <!-- Top Buttons: Profile & Hamburger -->
                    <ImageView
                        android:id="@+id/btn_home_profile"
                        style="@style/BotonIconoNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|start"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="16dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/white"
                        android:contentDescription="Perfil" />

                    <!-- Centered HOME & Logo -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:letterSpacing="0.08"
                            android:text="HOME"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/black"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_helmet_logo"
                            app:tint="@color/white"
                            android:contentDescription="Logo" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_home_hamburger"
                        style="@style/BotonIconoNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/white"
                        android:contentDescription="Menu" />

                    <!-- Liquid Glass Search Bar -->
                    <LinearLayout
                        android:id="@+id/ll_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_gravity="bottom"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/bg_glass_search"
                        android:elevation="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_search"
                            app:tint="#333333"
                            android:contentDescription="Buscar" />

                        <EditText
                            android:id="@+id/et_search"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Buscar motos, cascos, repuestos..."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:textColor="@color/biker_black"
                            android:textColorHint="@color/biker_gray_text"
                            android:textSize="13sp" />

                        <ImageView
                            android:id="@+id/btn_clear_search"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="3dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/biker_gray_text"
                            android:contentDescription="Limpiar" />
                    </LinearLayout>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category Buttons Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <!-- 1. MOTOCICLETAS Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_motos"
                    style="@style/TarjetaElevada"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_cat_motos"
                            android:contentDescription="Motocicletas" />

                        <!-- Darkened Matte Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="serif"
                            android:letterSpacing="0.12"
                            android:text="MOTOCICLETAS"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/black"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. CASCOS Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_cascos"
                    style="@style/TarjetaElevada"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_cat_cascos"
                            android:contentDescription="Cascos" />

                        <!-- Darkened Matte Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="serif"
                            android:letterSpacing="0.12"
                            android:text="CASCOS"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/black"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. INDUMENTARIA Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_indumentaria"
                    style="@style/TarjetaElevada"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_cat_indumentaria"
                            android:contentDescription="Indumentaria" />

                        <!-- Darkened Matte Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="serif"
                            android:letterSpacing="0.12"
                            android:text="INDUMENTARIA"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/black"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Scrim / Backdrop when search is active -->
    <View
        android:id="@+id/view_search_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Live Search Suggestions Overlay Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_search_results"
        style="@style/TarjetaElevada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="280dp"
        android:elevation="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- Search Header / Results Count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tv_search_results_count"
                    style="@style/TextoSecundario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sugerencias de búsqueda"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_close_search_overlay"
                    style="@style/TextoEnlaceAzul"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Cerrar ✕"
                    android:textColor="@color/biker_gray_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="4dp"
                android:background="#F3F4F6" />

            <!-- Suggestions RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- No Results Message -->
            <TextView
                android:id="@+id/tv_no_search_results"
                style="@style/TextoSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="18dp"
                android:text="No se encontraron productos coincidentes"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
