<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Bottom Helmet Watermark -->
    <ImageView
        android:id="@+id/iv_home_watermark"
        style="@style/MarcaAguaCasco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Top Header Banner with Curved Bottom -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_home_banner"
                style="@style/TarjetaBannerHome"
                android:layout_width="match_parent"
                android:layout_height="210dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Banner Background Image -->
                    <ImageView
                        android:id="@+id/iv_home_banner_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_store_banner"
                        android:contentDescription="Banner Chelo Biker Shop" />

                    <!-- Dark Semi-transparent Overlay -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#55000000" />

                    <!-- Top Buttons: Profile & Hamburger -->
                    <ImageView
                        android:id="@+id/btn_home_profile"
                        style="@style/BotonIconoNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|start"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="16dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/white"
                        android:contentDescription="Perfil" />

                    <!-- Centered HOME & Logo -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:letterSpacing="0.08"
                            android:text="HOME"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/black"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_helmet_logo"
                            app:tint="@color/white"
                            android:contentDescription="Logo" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_home_hamburger"
                        style="@style/BotonIconoNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="16dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/white"
                        android:contentDescription="Menu" />

                    <!-- Liquid Glass Search Bar -->
                    <LinearLayout
                        android:id="@+id/ll_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_gravity="bottom"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/bg_glass_search"
                        android:elevation="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_search"
                            app:tint="#333333"
                            android:contentDescription="Buscar" />

                        <EditText
                            android:id="@+id/et_search"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:hint="Buscar motos, cascos, repuestos..."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:textColor="@color/biker_black"
                            android:textColorHint="@color/biker_gray_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category Buttons Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <!-- 1. MOTOCICLETAS Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_motos"
                    style="@style/TarjetaElevada"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_cat_motos"
                            android:contentDescription="Motocicletas" />

                        <!-- Darkened Matte Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="serif"
                            android:letterSpacing="0.12"
                            android:text="MOTOCICLETAS"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/black"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. CASCOS Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_cascos"
                    style="@style/TarjetaElevada"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_cat_cascos"
                            android:contentDescription="Cascos" />

                        <!-- Darkened Matte Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="serif"
                            android:letterSpacing="0.12"
                            android:text="CASCOS"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/black"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. INDUMENTARIA Card Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_cat_indumentaria"
                    style="@style/TarjetaElevada"
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_cat_indumentaria"
                            android:contentDescription="Indumentaria" />

                        <!-- Darkened Matte Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#A6000000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="serif"
                            android:letterSpacing="0.12"
                            android:text="INDUMENTARIA"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/black"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
