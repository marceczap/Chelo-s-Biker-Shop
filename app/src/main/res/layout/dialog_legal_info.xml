<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_legal"
            app:tint="@color/biker_black"
            android:contentDescription="Legal" />

        <TextView
            android:id="@+id/tv_legal_dialog_title"
            style="@style/TextoTituloVintage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/legal_dialog_title"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#F3F4F6" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                style="@style/TextoEncabezadoSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legal_sec1_title"
                android:textSize="12sp" />

            <TextView
                style="@style/TextoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/legal_sec1_desc"
                android:textColor="#4B5563" />

            <TextView
                style="@style/TextoEncabezadoSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legal_sec2_title"
                android:textSize="12sp" />

            <TextView
                style="@style/TextoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/legal_sec2_desc"
                android:textColor="#4B5563" />

            <TextView
                style="@style/TextoEncabezadoSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legal_sec3_title"
                android:textSize="12sp" />

            <TextView
                style="@style/TextoSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/legal_sec3_desc"
                android:textColor="#4B5563" />

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_close_legal"
        style="@style/BotonPrimario"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="@string/legal_btn_accept"
        android:textSize="12sp" />

</LinearLayout>
