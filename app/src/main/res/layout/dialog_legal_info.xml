<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:backgroundTint="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_legal"
            app:tint="#111111"
            android:contentDescription="Legal" />

        <TextView
            android:id="@+id/tv_legal_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="serif"
            android:text="Información Legal"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#F3F4F6" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. TÉRMINOS Y CONDICIONES DE USO"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:lineSpacingExtra="3dp"
                android:text="El presente documento establece las condiciones de compra, reserva de motocicletas, repuestos y equipamiento homologado a través de Chelo Biker Shop S.R.L. Toda orden emitida cuenta con respaldo de factura fiscal autorizada por el SIN Bolivia."
                android:textColor="#4B5563"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. POLÍTICA DE PRIVACIDAD Y DATOS PERSONALES"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Los datos de contacto, facturación (NIT/CI) y seguridad biker almacenados en esta aplicación se procesan de forma cifrada bajo protocolos estrictos de confidencialidad para fines exclusivos de gestión de pedidos y entrega en sucursal."
                android:textColor="#4B5563"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. GARANTÍA DE FÁBRICA Y HOMOLOGACIONES"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Todas las motocicletas cuentan con 1 año o 10,000 km de garantía de fábrica oficial. Los cascos cuentan con certificación internacional DOT / ECE 22.06 y la indumentaria con protecciones CE Nivel 2."
                android:textColor="#4B5563"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_close_legal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_btn"
        android:backgroundTint="#111111"
        android:text="ENTENDIDO"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
