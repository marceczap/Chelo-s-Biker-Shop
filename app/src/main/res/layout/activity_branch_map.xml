<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/branch_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Subtle Tire Tracks Background Watermark -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.12"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_tire_tracks"
        android:contentDescription="Fondo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header with City Name -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btn_map_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Volver"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#111111" />

            <TextView
                android:id="@+id/tv_city_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:text="La paz"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Google Maps Interactive Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Interactive Web Map or Static View -->
                <WebView
                    android:id="@+id/wv_google_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Google Maps Place Card (Overlay) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_place_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/iv_place_thumb"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_store_banner"
                            android:contentDescription="Sucursal" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_place_code"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="FW67+66F La Paz"
                                android:textColor="#111111"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_place_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Av. Rafael Pabón, Megacenter Irpavi"
                                android:textColor="#555555"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Directions / Navigation Button -->
                        <FrameLayout
                            android:id="@+id/btn_place_directions"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_circle_arrow_btn"
                            android:backgroundTint="#00887A"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_directions"
                                app:tint="#FFFFFF"
                                android:contentDescription="Cómo llegar" />
                        </FrameLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- REALIZAR COMPRA ➔ Button -->
        <LinearLayout
            android:id="@+id/btn_realizar_compra"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="6dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:text="REALIZAR COMPRA"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#111111"
                android:contentDescription="Flecha" />
        </LinearLayout>

        <!-- Bottom Navigation Bar matching Figma -->
        <LinearLayout
            android:id="@+id/ll_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/nav_btn_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="#888888"
                    android:contentDescription="Perfil" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="#111111"
                    android:contentDescription="Home" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_btn_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu"
                    app:tint="#888888"
                    android:contentDescription="Menu" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
