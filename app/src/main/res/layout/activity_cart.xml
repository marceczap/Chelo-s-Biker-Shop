<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Bottom Watermark Casco -->
    <ImageView
        android:id="@+id/iv_cart_watermark"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-40dp"
        android:layout_marginBottom="-40dp"
        android:alpha="0.15"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_helmet_logo"
        android:contentDescription="Watermark" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Navigation Bar -->
        <LinearLayout
            android:id="@+id/ll_cart_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_cart_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#111111"
                android:contentDescription="Regresar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:letterSpacing="0.06"
                android:text="Carrito de Compras"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.7"
                android:src="@drawable/ic_helmet_logo"
                android:contentDescription="Logo" />
        </LinearLayout>

        <!-- Scrollable Checkout Content -->
        <ScrollView
            android:id="@+id/sv_cart_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_nav"
            app:layout_constraintTop_toBottomOf="@+id/ll_cart_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="30dp">

                <!-- 1. Lista Dinámica de Productos en Carrito -->
                <LinearLayout
                    android:id="@+id/ll_cart_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 2. Datos de Facturación Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:letterSpacing="0.06"
                            android:text="Datos de Facturación y Envío"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Nombre / Razón Social -->
                        <EditText
                            android:id="@+id/et_billing_name"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="Nombre Completo / Razón Social"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="14dp"
                            android:textColor="#111111"
                            android:textColorHint="#888888"
                            android:textSize="13sp" />

                        <!-- NIT / CI -->
                        <EditText
                            android:id="@+id/et_billing_nit"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="NIT o Carnet de Identidad (CI)"
                            android:inputType="number"
                            android:paddingHorizontal="14dp"
                            android:textColor="#111111"
                            android:textColorHint="#888888"
                            android:textSize="13sp" />

                        <!-- Teléfono WhatsApp -->
                        <EditText
                            android:id="@+id/et_billing_phone"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="Teléfono / WhatsApp de contacto"
                            android:inputType="phone"
                            android:paddingHorizontal="14dp"
                            android:textColor="#111111"
                            android:textColorHint="#888888"
                            android:textSize="13sp" />

                        <!-- Dirección / Sucursal -->
                        <EditText
                            android:id="@+id/et_billing_address"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="Dirección de entrega o Sucursal de retiro"
                            android:inputType="textPostalAddress"
                            android:paddingHorizontal="14dp"
                            android:textColor="#111111"
                            android:textColorHint="#888888"
                            android:textSize="13sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. Métodos de Pago Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:letterSpacing="0.06"
                            android:text="Método de Pago"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rg_payment_methods"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <RadioButton
                                android:id="@+id/rb_pay_qr"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:paddingVertical="6dp"
                                android:text="📱 Pago Fácil QR Simple (Banco Nacional)"
                                android:textColor="#222222"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rb_pay_card"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="6dp"
                                android:text="💳 Tarjeta de Débito / Crédito (Visa/Mastercard)"
                                android:textColor="#222222"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rb_pay_cash"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="6dp"
                                android:text="💵 Pago Contra Entrega en Tienda"
                                android:textColor="#222222"
                                android:textSize="13sp" />
                        </RadioGroup>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 4. Desglose de Costos Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Subtotal"
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_cart_subtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$4,800 USD"
                                android:textColor="#111111"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Envío Biker Seguro"
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GRATIS"
                                android:textColor="#10B981"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="#E5E7EB" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="serif"
                                android:text="Total a Pagar"
                                android:textColor="#111111"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_cart_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:text="$4,800 USD"
                                android:textColor="#D97706"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Botón ELEGIR SUCURSAL DE RETIRO -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_confirm_checkout"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_pill_btn"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:text="ELEGIR SUCURSAL DE RETIRO ➔"
                    android:textColor="#111111"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:id="@+id/ll_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Profile Button -->
            <FrameLayout
                android:id="@+id/nav_btn_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="#888888"
                    android:contentDescription="Perfil" />
            </FrameLayout>

            <!-- Home Button -->
            <FrameLayout
                android:id="@+id/nav_btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="#111111"
                    android:contentDescription="Home" />
            </FrameLayout>

            <!-- Menu / Branches Button -->
            <FrameLayout
                android:id="@+id/nav_btn_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu"
                    app:tint="#888888"
                    android:contentDescription="Sucursales" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
