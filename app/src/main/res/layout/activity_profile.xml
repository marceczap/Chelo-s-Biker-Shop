<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Bottom Left Large Helmet Watermark -->
    <ImageView
        android:id="@+id/iv_profile_watermark"
        style="@style/MarcaAguaCasco"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="-40dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Navigation Bar -->
        <LinearLayout
            android:id="@+id/ll_profile_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_profile_back"
                style="@style/BotonIconoNav"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/biker_black"
                android:contentDescription="Regresar" />

            <TextView
                style="@style/TextoTituloVintage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Mi Perfil Biker" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.6"
                android:src="@drawable/ic_helmet_logo"
                android:contentDescription="Logo" />
        </LinearLayout>

        <!-- Scrollable Profile Content -->
        <ScrollView
            android:id="@+id/sv_profile_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_profile_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="30dp">

                <!-- 1. Biker Avatar & Credential Badge -->
                <androidx.cardview.widget.CardView
                    style="@style/TarjetaElevada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle_color_black"
                                android:backgroundTint="#E2E8F0" />

                            <ImageView
                                android:id="@+id/iv_avatar"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                app:tint="#334155"
                                android:contentDescription="Avatar" />

                            <!-- Camera badge -->
                            <FrameLayout
                                android:id="@+id/btn_change_avatar"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_badge_circle"
                                android:backgroundTint="@color/biker_black"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="📷"
                                    android:textSize="12sp" />
                            </FrameLayout>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_display_name"
                            style="@style/TextoTituloVintage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Marcelo Biker"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tv_display_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_price_pill_amber"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="3dp"
                            android:text="🏍️ PILOTO PRO • CHELO MEMBER"
                            android:textColor="@color/biker_amber_price"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. Datos Personales Card -->
                <androidx.cardview.widget.CardView
                    style="@style/TarjetaContenedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextoEncabezadoSeccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información de Contacto" />

                        <!-- Nombre -->
                        <TextView
                            style="@style/TextoEtiquetaFormulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Nombre y Apellidos" />

                        <EditText
                            android:id="@+id/et_profile_name"
                            style="@style/CampoTextoFormulario"
                            android:layout_marginTop="4dp"
                            android:hint="Marcelo Biker"
                            android:inputType="textPersonName" />

                        <!-- Correo -->
                        <TextView
                            style="@style/TextoEtiquetaFormulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Correo Electrónico" />

                        <EditText
                            android:id="@+id/et_profile_email"
                            style="@style/CampoTextoFormulario"
                            android:layout_marginTop="4dp"
                            android:hint="marcelo@chelobikershop.bo"
                            android:inputType="textEmailAddress" />

                        <!-- Teléfono -->
                        <TextView
                            style="@style/TextoEtiquetaFormulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Teléfono / WhatsApp" />

                        <EditText
                            android:id="@+id/et_profile_phone"
                            style="@style/CampoTextoFormulario"
                            android:layout_marginTop="4dp"
                            android:hint="+591 76543210"
                            android:inputType="phone" />

                        <!-- CI / NIT -->
                        <TextView
                            style="@style/TextoEtiquetaFormulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Carnet de Identidad (CI) / NIT" />

                        <EditText
                            android:id="@+id/et_profile_ci"
                            style="@style/CampoTextoFormulario"
                            android:layout_marginTop="4dp"
                            android:hint="8472910 CBBA"
                            android:inputType="text" />

                        <!-- Ciudad -->
                        <TextView
                            style="@style/TextoEtiquetaFormulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Ciudad / Ubicación" />

                        <EditText
                            android:id="@+id/et_profile_city"
                            style="@style/CampoTextoFormulario"
                            android:layout_marginTop="4dp"
                            android:hint="Cochabamba, Bolivia"
                            android:inputType="textPostalAddress" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. Perfil Biker & Garaje Card -->
                <androidx.cardview.widget.CardView
                    style="@style/TarjetaContenedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextoEncabezadoSeccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Garaje Biker &amp; Seguridad" />

                        <!-- Mi Moto Actual -->
                        <TextView
                            style="@style/TextoEtiquetaFormulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="🏍️ Mi Moto Actual / Favorita" />

                        <EditText
                            android:id="@+id/et_profile_moto"
                            style="@style/CampoTextoFormulario"
                            android:layout_marginTop="4dp"
                            android:hint="KTM Enduro 250 XC"
                            android:inputType="text" />

                        <!-- Licencia -->
                        <TextView
                            style="@style/TextoEtiquetaFormulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="🪪 Licencia de Conducir" />

                        <EditText
                            android:id="@+id/et_profile_license"
                            style="@style/CampoTextoFormulario"
                            android:layout_marginTop="4dp"
                            android:hint="Categoría M (Biker Pro)"
                            android:inputType="text" />

                        <!-- Emergencia -->
                        <TextView
                            style="@style/TextoEtiquetaFormulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="🩸 Grupo Sanguíneo &amp; Contacto Emergencia" />

                        <EditText
                            android:id="@+id/et_profile_emergency"
                            style="@style/CampoTextoFormulario"
                            android:layout_marginTop="4dp"
                            android:hint="O+ • Contacto: 71234567"
                            android:inputType="text" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 4. Action Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_save_profile"
                    style="@style/BotonPrimario"
                    android:text="GUARDAR CAMBIOS" />

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar (Profile Active) -->
        <LinearLayout
            android:id="@+id/ll_bottom_nav"
            style="@style/BarraNavegacionInferior"
            android:layout_width="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Profile Button (Active) -->
            <FrameLayout
                android:id="@+id/nav_btn_profile"
                style="@style/ItemNavegacion">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/biker_black"
                    android:contentDescription="Perfil" />
            </FrameLayout>

            <!-- Home Button -->
            <FrameLayout
                android:id="@+id/nav_btn_home"
                style="@style/ItemNavegacion">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="@color/biker_gray_muted"
                    android:contentDescription="Home" />
            </FrameLayout>

            <!-- Menu / Branches Button -->
            <FrameLayout
                android:id="@+id/nav_btn_menu"
                style="@style/ItemNavegacion">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/biker_gray_muted"
                    android:contentDescription="Menu" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
