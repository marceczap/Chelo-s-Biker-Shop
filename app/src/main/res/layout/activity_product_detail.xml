<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/product_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Bottom Left Large Helmet Watermark -->
    <ImageView
        android:id="@+id/iv_detail_watermark"
        style="@style/MarcaAguaCasco"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-30dp"
        android:layout_marginBottom="-30dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Navigation -->
        <LinearLayout
            android:id="@+id/ll_detail_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_detail_back"
                style="@style/BotonIconoNav"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/biker_black"
                android:contentDescription="Regresar" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.7"
                android:src="@drawable/ic_helmet_logo"
                android:contentDescription="Logo" />
        </LinearLayout>

        <!-- Scrollable Content of Product Detail -->
        <ScrollView
            android:id="@+id/sv_detail_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_detail_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <!-- Product Name / Title in Gothic / Serif Style -->
                <TextView
                    android:id="@+id/tv_detail_title"
                    style="@style/TextoTituloVintage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="KTM POWER 250CC"
                    android:textSize="18sp" />

                <!-- Product Image inside Framed Box with Soft Shadow -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_detail_image"
                    style="@style/TarjetaContenedor"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="6dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/iv_detail_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_moto_1"
                            android:contentDescription="Producto" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Technical Specifications List -->
                <LinearLayout
                    android:id="@+id/ll_detail_specs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_spec_1"
                        style="@style/TextoEncabezadoSeccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:text="CILINDRADA 250CC" />

                    <TextView
                        android:id="@+id/tv_spec_2"
                        style="@style/TextoEncabezadoSeccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:text="MOTOR A VARILLA" />

                    <TextView
                        android:id="@+id/tv_spec_3"
                        style="@style/TextoEncabezadoSeccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:text="TANQUE 13 LTS" />

                    <TextView
                        android:id="@+id/tv_spec_4"
                        style="@style/TextoEncabezadoSeccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:text="FRENOS A DISCO" />

                    <TextView
                        android:id="@+id/tv_spec_5"
                        style="@style/TextoEncabezadoSeccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:text="TABLERO DIGITAL" />
                </LinearLayout>

                <!-- Colores Disponibles Section -->
                <TextView
                    android:id="@+id/tv_colors_title"
                    style="@style/TextoEncabezadoSeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/colors_available"
                    android:textSize="14sp" />

                <!-- Modern Biker Color Combo Box (Spinner) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_combobox_selector">

                    <Spinner
                        android:id="@+id/spinner_product_color"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:dropDownVerticalOffset="4dp"
                        android:gravity="center_vertical"
                        android:overlapAnchor="false"
                        android:popupBackground="@drawable/bg_dropdown_popup"
                        android:spinnerMode="dropdown" />

                    <!-- Dropdown Arrow Indicator -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="8dp"
                        android:rotation="90"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/biker_black"
                        android:contentDescription="Desplegar" />
                </FrameLayout>

                <!-- Price Display -->
                <TextView
                    android:id="@+id/tv_detail_price"
                    style="@style/TextoPrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="$4,800 USD"
                    android:textSize="18sp" />

                <!-- AGREGAR AL CARRITO Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_add_to_cart"
                    style="@style/BotonPrimario"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="AGREGAR AL CARRITO" />

            </LinearLayout>
        </ScrollView>

        <!-- Floating Shopping Cart Button (Estandarizado) -->
        <include
            android:id="@+id/btn_floating_cart"
            layout="@layout/layout_floating_cart"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Navigation Bar (Estandarizado) -->
        <include
            android:id="@+id/ll_bottom_nav"
            layout="@layout/layout_bottom_nav"
            android:layout_width="0dp"
            android:layout_height="62dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Overlay Container for Fly-to-Cart Animation -->
    <FrameLayout
        android:id="@+id/fl_fly_animation_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

</FrameLayout>
