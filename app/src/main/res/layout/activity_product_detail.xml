<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/product_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Bottom Left Large Helmet Watermark matching Figma P6 -->
    <ImageView
        android:id="@+id/iv_detail_watermark"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-30dp"
        android:layout_marginBottom="-30dp"
        android:alpha="0.22"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_helmet_logo"
        android:contentDescription="Watermark Casco" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Navigation -->
        <LinearLayout
            android:id="@+id/ll_detail_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_detail_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#111111"
                android:contentDescription="Regresar" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.7"
                android:src="@drawable/ic_helmet_logo"
                android:contentDescription="Logo" />
        </LinearLayout>

        <!-- Scrollable Content of Product Detail -->
        <ScrollView
            android:id="@+id/sv_detail_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_detail_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <!-- Product Name / Title in Gothic / Serif Style -->
                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="KTM POWER 250CC"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Product Image inside Framed Box with Soft Shadow -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_detail_image"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/iv_detail_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_moto_1"
                            android:contentDescription="Producto" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Technical Specifications List (Centered Uppercase matching Figma) -->
                <LinearLayout
                    android:id="@+id/ll_detail_specs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_spec_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.06"
                        android:text="CILINDRADA 250CC"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_spec_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.06"
                        android:text="MOTOR A VARILLA"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_spec_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.06"
                        android:text="TANQUE 13 LTS"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_spec_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.06"
                        android:text="FRENOS A DISCO"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_spec_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.06"
                        android:text="TABLERO DIGITAL"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Colores Disponibles Section -->
                <TextView
                    android:id="@+id/tv_colors_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:text="COLORES DISPONIBLES"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 3 Color Variation Circles -->
                <LinearLayout
                    android:id="@+id/ll_colors_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Black Option -->
                    <FrameLayout
                        android:id="@+id/btn_color_black"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_circle_color_black"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true" />

                    <!-- Red Option -->
                    <FrameLayout
                        android:id="@+id/btn_color_red"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_circle_color_red"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true" />

                    <!-- Green Option -->
                    <FrameLayout
                        android:id="@+id/btn_color_green"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_circle_color_green"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Price Display -->
                <TextView
                    android:id="@+id/tv_detail_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:text="$4,800 USD"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- AGREGAR AL CARRITO Button (Grey Pill matching Figma) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_add_to_cart"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_pill_btn"
                    android:fontFamily="serif"
                    android:letterSpacing="0.1"
                    android:text="AGREGAR AL CARRITO"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <!-- Floating Shopping Cart Button -->
        <FrameLayout
            android:id="@+id/btn_floating_cart"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_nav"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_floating_cart"
                android:elevation="6dp" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:src="@drawable/ic_shopping_cart"
                app:tint="#FFFFFF"
                android:contentDescription="Carrito" />

            <TextView
                android:id="@+id/tv_cart_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_circle"
                android:elevation="10dp"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:id="@+id/ll_bottom_nav"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Profile Button -->
            <FrameLayout
                android:id="@+id/nav_btn_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="#888888"
                    android:contentDescription="Perfil" />
            </FrameLayout>

            <!-- Home Button -->
            <FrameLayout
                android:id="@+id/nav_btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="#111111"
                    android:contentDescription="Home" />
            </FrameLayout>

            <!-- Menu / Branches Button -->
            <FrameLayout
                android:id="@+id/nav_btn_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu"
                    app:tint="#888888"
                    android:contentDescription="Sucursales" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Overlay Container for Fly-to-Cart Animation -->
    <FrameLayout
        android:id="@+id/fl_fly_animation_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

</FrameLayout>
