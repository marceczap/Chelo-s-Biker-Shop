<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_phone"
            app:tint="@color/biker_black"
            android:contentDescription="Contacto" />

        <TextView
            android:id="@+id/tv_contact_dialog_title"
            style="@style/TextoTituloVintage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Contáctanos"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#F3F4F6" />

    <!-- WhatsApp Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btn_contact_whatsapp"
        style="@style/TarjetaOpcionMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#ECFDF5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoEncabezadoSeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp Oficial"
                    android:textColor="#065F46"
                    android:textSize="13sp" />

                <TextView
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+591 76543210 (Atención 24/7)"
                    android:textColor="#047857" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_btn"
                android:backgroundTint="#10B981"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="CHATEAR"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Phone Call Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btn_contact_call"
        style="@style/TarjetaOpcionMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#F0F9FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoEncabezadoSeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Llamada Telefónica"
                    android:textColor="#075985"
                    android:textSize="13sp" />

                <TextView
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+591 2 2789000 (Central La Paz)"
                    android:textColor="#0284C7" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_btn"
                android:backgroundTint="#0284C7"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="LLAMAR"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Email Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btn_contact_email"
        style="@style/TarjetaOpcionMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/biker_gray_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉️"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextoEncabezadoSeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo de Soporte"
                    android:textColor="#1F2937"
                    android:textSize="13sp" />

                <TextView
                    style="@style/TextoSecundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="contacto@chelobiker.com"
                    android:textColor="#4B5563" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_btn"
                android:backgroundTint="#374151"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ENVIAR"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Store Hours Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_id_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/TextoEncabezadoSeccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Casa Matriz &amp; Talleres:"
            android:textSize="11.5sp" />

        <TextView
            style="@style/TextoSecundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Av. Rafael Pabón, MegaCenter Irpavi • La Paz, Bolivia" />

        <TextView
            style="@style/TextoEncabezadoSeccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="⏰ Horario de Atención: Lun a Sáb: 09:00 - 19:30"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_close_contact"
        style="@style/BotonPrimario"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="CERRAR"
        android:textSize="12sp" />

</LinearLayout>
