<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/branches_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Subtle Tire Tracks Background Watermark -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.12"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_tire_tracks"
        android:contentDescription="Fondo" />

    <!-- Helmet Watermark -->
    <ImageView
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="-30dp"
        android:alpha="0.15"
        android:src="@drawable/ic_helmet_logo"
        android:contentDescription="Watermark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:weightSum="1">

        <!-- Top Header with Back Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btn_branches_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Volver"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#111111" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:src="@drawable/ic_helmet_logo"
                android:contentDescription="Logo" />
        </FrameLayout>

        <!-- Main Title: DONDE RECOJERAS TU ADQUISICION -->
        <TextView
            android:id="@+id/tv_branches_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:lineSpacingExtra="4dp"
            android:text="DONDE RECOJERAS TU ADQUISICION"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 3 City Branch Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 1. La Paz -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_branch_lapaz"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginVertical="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="24dp"
                app:cardElevation="5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_thumb_lapaz"
                        android:contentDescription="Mapa La Paz" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="serif"
                        android:letterSpacing="0.06"
                        android:text="La paz"
                        android:textColor="#111111"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. El Alto -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_branch_elalto"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginVertical="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="24dp"
                app:cardElevation="5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_thumb_elalto"
                        android:contentDescription="Mapa El Alto" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="serif"
                        android:letterSpacing="0.06"
                        android:text="El Alto"
                        android:textColor="#111111"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Cochabamba -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_branch_cochabamba"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginVertical="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="24dp"
                app:cardElevation="5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_thumb_cochabamba"
                        android:contentDescription="Mapa Cochabamba" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="serif"
                        android:letterSpacing="0.06"
                        android:text="Cochabamba"
                        android:textColor="#111111"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Subtitle Footer Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Tu pedido sera enviado\na la sucursal de la ciudad\nseleccionada"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
