<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/branches_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/biker_gray_bg">

    <!-- Subtle Tire Tracks Background Watermark -->
    <ImageView
        style="@style/MarcaAguaFondo" />

    <!-- Helmet Watermark -->
    <ImageView
        style="@style/MarcaAguaCascoEsquina"
        android:layout_marginStart="-40dp"
        android:layout_marginBottom="-30dp"
        android:alpha="0.15" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:weightSum="1">

        <!-- Top Header with Back Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btn_branches_back"
                style="@style/BotonIconoNav"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/biker_black" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:src="@drawable/ic_helmet_logo"
                android:contentDescription="Logo" />
        </FrameLayout>

        <!-- Main Title: DONDE RECOJERAS TU ADQUISICION -->
        <TextView
            android:id="@+id/tv_branches_title"
            style="@style/TextoTituloVintage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:lineSpacingExtra="4dp"
            android:text="DONDE RECOJERAS TU ADQUISICION"
            android:textSize="18sp" />

        <!-- 3 City Branch Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 1. La Paz -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_branch_lapaz"
                style="@style/TarjetaSucursal"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginVertical="10dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_thumb_lapaz"
                        android:contentDescription="Mapa La Paz" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66FFFFFF" />

                    <TextView
                        style="@style/TextoTituloVintage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="La paz"
                        android:textSize="22sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. El Alto -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_branch_elalto"
                style="@style/TarjetaSucursal"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginVertical="10dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_thumb_elalto"
                        android:contentDescription="Mapa El Alto" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66FFFFFF" />

                    <TextView
                        style="@style/TextoTituloVintage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="El Alto"
                        android:textSize="22sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Cochabamba -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_branch_cochabamba"
                style="@style/TarjetaSucursal"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginVertical="10dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_thumb_cochabamba"
                        android:contentDescription="Mapa Cochabamba" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#66FFFFFF" />

                    <TextView
                        style="@style/TextoTituloVintage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Cochabamba"
                        android:textSize="22sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Subtitle Footer Note -->
        <TextView
            style="@style/TextoSubtituloVintage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Tu pedido sera enviado\na la sucursal de la ciudad\nseleccionada"
            android:textColor="#333333"
            android:textSize="14sp" />

    </LinearLayout>
</FrameLayout>
