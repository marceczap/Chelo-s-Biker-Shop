<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- Subtle Tire Tracks Background Watermark -->
    <ImageView
        android:id="@+id/iv_bg_watermark"
        style="@style/MarcaAguaFondo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Arched Brand Logo with Helmet -->
            <LinearLayout
                android:id="@+id/ll_logo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_brand_arch"
                    style="@style/TextoTituloGrande"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chelo´s  Biker  Shop" />

                <ImageView
                    android:id="@+id/iv_helmet_logo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="2dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Chelo Biker Shop Logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_helmet_logo" />

                <TextView
                    android:id="@+id/tv_brand_est"
                    style="@style/TextoTituloVintage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Est. 2026"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Store Showroom Banner Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_store_banner"
                style="@style/TarjetaElevada"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_marginTop="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_logo_container">

                <ImageView
                    android:id="@+id/iv_store_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Tienda de Motos"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_store_banner" />
            </androidx.cardview.widget.CardView>

            <!-- Subtitle Tienda de Motos -->
            <TextView
                android:id="@+id/tv_store_subtitle"
                style="@style/TextoSubtituloVintage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tienda de Motos"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_store_banner" />

            <!-- Title Iniciar Sesión -->
            <TextView
                android:id="@+id/tv_login_title"
                style="@style/TextoEncabezadoSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Iniciar Sesión"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_store_subtitle" />

            <!-- Input Correo -->
            <EditText
                android:id="@+id/et_email"
                style="@style/CampoTextoPill"
                android:layout_width="0dp"
                android:layout_marginTop="10dp"
                android:hint="correo"
                android:inputType="textEmailAddress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_login_title" />

            <!-- Input Contraseña -->
            <EditText
                android:id="@+id/et_password"
                style="@style/CampoTextoPill"
                android:layout_width="0dp"
                android:layout_marginTop="10dp"
                android:hint="contraseña"
                android:inputType="textPassword"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_email" />

            <!-- No tienes una cuenta? REGISTRATE -->
            <LinearLayout
                android:id="@+id/ll_register_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_password">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="No tienes una cuenta? "
                    android:textColor="@color/biker_black"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_register_btn"
                    style="@style/TextoEnlaceAzul"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGISTRATE" />
            </LinearLayout>

            <!-- Action Button ( INGRESAR en color verde ) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_login_arrow"
                style="@style/BotonPrimarioVerde"
                android:layout_width="0dp"
                android:layout_marginTop="14dp"
                android:layout_marginHorizontal="20dp"
                android:text="INGRESAR"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_register_link" />

            <!-- Siguenos Section -->
            <TextView
                android:id="@+id/tv_siguenos"
                style="@style/TextoEncabezadoSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Siguenos"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_login_arrow" />

            <!-- Social Icons Row (Facebook, Instagram, YouTube) -->
            <LinearLayout
                android:id="@+id/ll_social_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_siguenos">

                <!-- Facebook -->
                <ImageView
                    android:id="@+id/btn_social_fb"
                    style="@style/BotonIconoNav"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="Facebook"
                    android:src="@drawable/ic_social_fb" />

                <!-- Instagram -->
                <ImageView
                    android:id="@+id/btn_social_ig"
                    style="@style/BotonIconoNav"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="Instagram"
                    android:src="@drawable/ic_social_ig" />

                <!-- YouTube -->
                <ImageView
                    android:id="@+id/btn_social_yt"
                    style="@style/BotonIconoNav"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="YouTube"
                    android:src="@drawable/ic_social_yt" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>